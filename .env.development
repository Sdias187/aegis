# =============================================================================
# AEGIS - Ambiente de Desenvolvimento
# =============================================================================
# NOTA: Em desenvolvimento com MSW ativo, use URL relativa (/api/v1)
# para que as requisições sejam interceptadas pelo Service Worker (MSW)
# no mesmo origin do dev server (localhost:5173).
# O proxy do Vite redireciona para o backend quando o MSW estiver desligado.
VITE_API_URL=/api/v1
VITE_API_TIMEOUT=30000
VITE_APP_NAME=AEGIS
VITE_APP_VERSION=1.0.0
VITE_ENV=development
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_FF_DARK_MODE_DEFAULT=true
VITE_FF_ENABLE_GLOBAL_SEARCH=true
VITE_FF_ENABLE_MOCK_API=false
VITE_PWA_ENABLED=false
VITE_POLLING_INTERVAL=30000
