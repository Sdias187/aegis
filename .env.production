VITE_FF_DARK_MODE_DEFAULT=true
VITE_FF_ENABLE_GLOBAL_SEARCH=true
VITE_FF_ENABLE_MOCK_API=false
VITE_PWA_ENABLED=true
VITE_POLLING_INTERVAL=30000
