VITE_API_URL=/api/v1
VITE_API_TIMEOUT=30000
VITE_APP_NAME=AEGIS
VITE_APP_VERSION=1.0.0
VITE_ENV=production
VITE_SENTRY_DSN=https://your-dsn@sentry.io/your-project
